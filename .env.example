APP_NAME=工业安全智能监测系统
ENVIRONMENT=development
DATABASE_URL=sqlite:///./safety_monitor.db
SECRET_KEY=change-me-in-production-use-at-least-32-bytes
ACCESS_TOKEN_MINUTES=720
# E7: Expanded PPE + Kaggle PPE with targeted hard-case refinement; keep old weights for rollback.
MODEL_PATH=models/expanded-ppe-yolov8s-hardcase12.pt
MODEL_CONFIDENCE=0.25
MODEL_IMAGE_SIZE=640
# Empty means Ultralytics automatically selects CUDA when available, otherwise CPU.
MODEL_DEVICE=
ALLOW_MODEL_DOWNLOAD=false
FALLBACK_SCENARIO=compliant
UPLOAD_DIR=uploads
RESULT_DIR=results
MAX_UPLOAD_MB=100
# Bounded decode -> batch inference -> ordered tracker/rules/encode pipeline.
VIDEO_BATCH_SIZE=8
VIDEO_QUEUE_SIZE=16
VIDEO_DECODE_BACKEND=auto
VIDEO_ENCODE_BACKEND=auto
# Enabled only when CUDA is available; CPU deployments automatically use FP32.
VIDEO_HALF=true
# Set true only when MODEL_PATH points to an explicitly exported .engine file.
VIDEO_TENSORRT=false
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
QUEUE_WORKERS=1
# Each concurrent video worker owns a separate model instance. Keep 1 on an
# 8 GB GPU unless the free-memory check and a benchmark justify increasing it.
MAX_VIDEO_WORKERS=1
VIDEO_WORKER_MEMORY_MB=3072
CORS_ORIGINS=*
